{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "corepack enable pnpm && pnpm install --frozen-lockfile",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "images/activities/share-6x5/**"
    }
  },
  "rewrites": [
    {
      "source": "/:alias([a-z0-9-]+_[0-9a-fA-F]{8})",
      "destination": "/api/meta/activity-short?alias=:alias"
    },
    { "source": "/api/social/publish-event", "destination": "/api/admin/session?probe=social-publish-event" },
    {
      "source": "/api/admin/instagram-publisher-readiness",
      "destination": "/api/admin/session?probe=instagram-publisher-readiness"
    },
    {
      "source": "/e/:id",
      "destination": "/api/meta/event-preview?event=:id&capture=activity-attribution-v1"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/meta/event-preview?slug=:slug"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
