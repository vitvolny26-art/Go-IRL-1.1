#!/bin/sh
set -eu

PATH='/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
umask 022

RUNTIME_USER='goirl-runner'
WORKSPACE='/opt/actions-runner/_work/Go-IRL-1.1/Go-IRL-1.1'
DIST="$WORKSPACE/dist"
STAGE_ROOT='/opt/go-irl-stage'
STAGE="$STAGE_ROOT/dist"
PREV='/opt/go-irl-stage.prev'
LAYOUT_BACKUP='/opt/go-irl-stage.layout-before-repair'
STATE_DIR='/var/lib/go-irl-stage-publish'
MARKER="$STATE_DIR/last-run"

fail() {
  printf '%s\n' "BLOCKED: $*" >&2
  exit 2
}

require_root() {
  [ "$(id -u)" -eq 0 ] || fail 'stage publish helper must run as root through the restricted sudo rule'
}

require_sha() {
  expected=${1:-}
  case "$expected" in
    ''|*[!0-9a-f]*) fail 'expected SHA must be 40 lowercase hex characters' ;;
  esac
  [ "${#expected}" -eq 40 ] || fail 'expected SHA must be 40 lowercase hex characters'
}

require_run_id() {
  run_id=${1:-}
  case "$run_id" in
    ''|*[!0-9]*) fail 'GitHub run id must be numeric' ;;
  esac
  [ "${#run_id}" -le 20 ] || fail 'GitHub run id is unexpectedly long'
}

git_workspace() {
  command -v git >/dev/null 2>&1 || fail 'git missing'
  command -v runuser >/dev/null 2>&1 || fail 'runuser missing'
  id "$RUNTIME_USER" >/dev/null 2>&1 || fail 'goirl-runner user missing'
  runuser -u "$RUNTIME_USER" -- git -C "$WORKSPACE" "$@"
}

require_workspace() {
  expected=$1
  [ -d "$WORKSPACE/.git" ] || fail 'GitHub Actions workspace checkout missing'
  actual=$(git_workspace rev-parse HEAD)
  [ "$actual" = "$expected" ] || fail "workspace SHA mismatch expected=$expected actual=$actual"
  [ -z "$(git_workspace status --porcelain --untracked-files=no)" ] || fail 'workspace tracked files are dirty'
}

require_dist() {
  [ -d "$DIST" ] || fail 'dist directory missing'
  [ ! -L "$DIST" ] || fail 'dist must not be a symlink'
  [ -f "$DIST/index.html" ] || fail 'dist/index.html missing'
  [ ! -L "$DIST/index.html" ] || fail 'dist/index.html must not be a symlink'
  [ -s "$DIST/index.html" ] || fail 'dist/index.html is empty'
  unsafe=$(find "$DIST" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit)
  [ -z "$unsafe" ] || fail "dist contains unsupported file type: $unsafe"
}

require_stage_root() {
  [ -d "$STAGE_ROOT" ] || fail 'production stage root missing'
  [ ! -L "$STAGE_ROOT" ] || fail 'production stage root must not be a symlink'
  [ "$(stat -c '%U' /opt)" = 'root' ] || fail '/opt must be root-owned'
}

require_stage() {
  require_stage_root
  [ -d "$STAGE" ] || fail 'production dist directory missing'
  [ ! -L "$STAGE" ] || fail 'production dist directory must not be a symlink'
  [ -f "$STAGE/index.html" ] || fail 'production dist/index.html missing'
  [ ! -L "$STAGE/index.html" ] || fail 'production dist/index.html must not be a symlink'
  [ -s "$STAGE/index.html" ] || fail 'production dist/index.html is empty'
  unsafe=$(find "$STAGE" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit)
  [ -z "$unsafe" ] || fail "production dist contains unsupported file type: $unsafe"
}

require_flat_stage() {
  require_stage_root
  [ -f "$STAGE_ROOT/index.html" ] || fail 'flattened production index.html missing'
  [ ! -L "$STAGE_ROOT/index.html" ] || fail 'flattened production index.html must not be a symlink'
  [ -s "$STAGE_ROOT/index.html" ] || fail 'flattened production index.html is empty'
  unsafe=$(find "$STAGE_ROOT" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit)
  [ -z "$unsafe" ] || fail "flattened production stage contains unsupported file type: $unsafe"
}

require_state_dir() {
  if [ -e "$STATE_DIR" ] || [ -L "$STATE_DIR" ]; then
    [ -d "$STATE_DIR" ] || fail 'state path exists but is not a directory'
    [ ! -L "$STATE_DIR" ] || fail 'state directory must not be a symlink'
    [ "$(stat -c '%U' "$STATE_DIR")" = 'root' ] || fail 'state directory must be root-owned'
  else
    install -d -o root -g root -m 0700 "$STATE_DIR"
  fi
}

require_optional_dir() {
  path=$1
  label=$2
  if [ -e "$path" ] || [ -L "$path" ]; then
    [ -d "$path" ] || fail "$label exists but is not a directory"
    [ ! -L "$path" ] || fail "$label must not be a symlink"
  fi
}

clear_children() {
  dir=$1
  find "$dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
}

move_children() {
  from=$1
  to=$2
  for entry in "$from"/* "$from"/.[!.]* "$from"/..?*; do
    if [ -e "$entry" ] || [ -L "$entry" ]; then
      mv -- "$entry" "$to/" || return 1
    fi
  done
}

restore_previous() {
  clear_children "$STAGE" || return 1
  move_children "$PREV" "$STAGE" || return 1
  chown -R root:root "$STAGE" || return 1
  [ -s "$STAGE/index.html" ] || return 1
}

restore_flattened_layout() {
  clear_children "$STAGE_ROOT" || return 1
  cp -a -- "$LAYOUT_BACKUP/." "$STAGE_ROOT/" || return 1
  chown -R root:root "$STAGE_ROOT" || return 1
  [ -s "$STAGE_ROOT/index.html" ] || return 1
}

repair_layout() {
  require_root
  require_stage_root

  if [ -d "$STAGE" ] && [ ! -L "$STAGE" ]; then
    require_stage
    printf '%s\n' 'stage_layout_repair=noop'
    printf '%s\n' "stage=$STAGE"
    return 0
  fi

  if [ -e "$STAGE" ] || [ -L "$STAGE" ]; then
    fail 'non-canonical production dist path already exists'
  fi

  require_flat_stage

  if [ -e "$LAYOUT_BACKUP" ] || [ -L "$LAYOUT_BACKUP" ]; then
    fail 'layout repair backup path already exists'
  fi

  install -d -o root -g root -m 0755 "$LAYOUT_BACKUP"
  if ! cp -a -- "$STAGE_ROOT/." "$LAYOUT_BACKUP/"; then
    fail 'failed to create layout repair backup'
  fi
  chown -R root:root "$LAYOUT_BACKUP"
  [ -s "$LAYOUT_BACKUP/index.html" ] || fail 'layout repair backup index.html missing or empty'
  unsafe=$(find "$LAYOUT_BACKUP" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit)
  [ -z "$unsafe" ] || fail "layout repair backup contains unsupported file type: $unsafe"

  if ! clear_children "$STAGE_ROOT"; then
    restore_flattened_layout || true
    fail 'failed to clear flattened stage; restore attempted'
  fi

  if ! install -d -o root -g root -m 0755 "$STAGE"; then
    restore_flattened_layout || true
    fail 'failed to create canonical production dist; restore attempted'
  fi

  if ! cp -a -- "$LAYOUT_BACKUP/." "$STAGE/"; then
    restore_flattened_layout || true
    fail 'failed to populate canonical production dist; restore attempted'
  fi
  chown -R root:root "$STAGE"

  if [ ! -s "$STAGE/index.html" ]; then
    restore_flattened_layout || true
    fail 'canonical production dist/index.html missing after repair; restore attempted'
  fi
  unsafe=$(find "$STAGE" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit)
  if [ -n "$unsafe" ]; then
    restore_flattened_layout || true
    fail "canonical production dist contains unsupported file type after repair; restore attempted: $unsafe"
  fi

  printf '%s\n' 'stage_layout_repair=ok'
  printf '%s\n' "stage=$STAGE"
  printf '%s\n' "layout_backup=$LAYOUT_BACKUP"
}

preflight() {
  require_root
  id "$RUNTIME_USER" >/dev/null 2>&1 || fail 'goirl-runner user missing'
  command -v git >/dev/null 2>&1 || fail 'git missing'
  command -v runuser >/dev/null 2>&1 || fail 'runuser missing'
  command -v find >/dev/null 2>&1 || fail 'find missing'
  command -v install >/dev/null 2>&1 || fail 'install missing'
  command -v stat >/dev/null 2>&1 || fail 'stat missing'
  command -v cp >/dev/null 2>&1 || fail 'cp missing'
  command -v mv >/dev/null 2>&1 || fail 'mv missing'
  command -v rm >/dev/null 2>&1 || fail 'rm missing'
  command -v chown >/dev/null 2>&1 || fail 'chown missing'
  [ -d "$WORKSPACE" ] || fail 'expected GitHub Actions workspace path missing'
  require_stage
  require_optional_dir "$PREV" 'previous stage backup'
  printf '%s\n' 'stage_publish_preflight=ok'
  printf '%s\n' "workspace=$WORKSPACE"
  printf '%s\n' "stage=$STAGE"
}

publish() {
  expected=$1
  run_id=$2
  require_root
  require_sha "$expected"
  require_run_id "$run_id"
  require_workspace "$expected"
  require_dist
  require_stage
  require_state_dir

  next="$STAGE_ROOT.next-$run_id"
  marker_tmp="$STATE_DIR/last-run.tmp-$run_id"
  require_optional_dir "$PREV" 'previous stage backup'
  require_optional_dir "$next" 'next stage'
  [ ! -L "$marker_tmp" ] || fail 'temporary marker must not be a symlink'

  rm -rf -- "$next" "$PREV"
  rm -f -- "$marker_tmp"
  install -d -o root -g root -m 0755 "$next"
  install -d -o root -g root -m 0755 "$PREV"
  cp -a -- "$DIST/." "$next/"
  chown -R root:root "$next"
  [ -s "$next/index.html" ] || fail 'staged index.html is missing or empty after copy'
  unsafe=$(find "$next" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit)
  [ -z "$unsafe" ] || fail "staged artifact contains unsupported file type: $unsafe"

  umask 077
  printf '%s %s\n' "$expected" "$run_id" > "$marker_tmp"
  chmod 0600 "$marker_tmp"
  umask 022

  if ! move_children "$STAGE" "$PREV"; then
    move_children "$PREV" "$STAGE" || true
    rm -rf -- "$next"
    rm -f -- "$marker_tmp"
    fail 'failed to capture previous published dist; restore attempted'
  fi

  if ! move_children "$next" "$STAGE"; then
    clear_children "$STAGE" || true
    move_children "$PREV" "$STAGE" || true
    rm -rf -- "$next"
    rm -f -- "$marker_tmp"
    fail 'failed to activate staged dist; previous dist restore attempted'
  fi
  chown -R root:root "$STAGE"

  if [ ! -s "$STAGE/index.html" ]; then
    restore_previous || true
    rm -rf -- "$next"
    rm -f -- "$marker_tmp"
    fail 'published dist/index.html is missing or empty; previous dist restore attempted'
  fi
  unsafe=$(find "$STAGE" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit)
  if [ -n "$unsafe" ]; then
    restore_previous || true
    rm -rf -- "$next"
    rm -f -- "$marker_tmp"
    fail "published dist contains unsupported file type; previous dist restore attempted: $unsafe"
  fi

  if ! mv -- "$marker_tmp" "$MARKER"; then
    restore_previous || true
    rm -rf -- "$next"
    fail 'failed to record publish marker; previous dist restore attempted'
  fi
  rm -rf -- "$next"

  printf '%s\n' 'stage_publish=ok'
  printf '%s\n' "sha=$expected"
  printf '%s\n' "run_id=$run_id"
}

rollback() {
  expected=$1
  run_id=$2
  require_root
  require_sha "$expected"
  require_run_id "$run_id"
  require_workspace "$expected"
  require_stage
  require_state_dir
  require_optional_dir "$PREV" 'previous stage backup'
  [ -d "$PREV" ] || fail 'previous stage backup is unavailable for rollback'
  [ -f "$MARKER" ] || fail 'publish marker missing'

  marker=$(cat "$MARKER")
  [ "$marker" = "$expected $run_id" ] || fail 'publish marker does not match requested rollback'

  if ! restore_previous; then
    fail 'rollback restore failed; published dist may be incomplete'
  fi
  rm -f -- "$MARKER"

  printf '%s\n' 'stage_rollback=ok'
  printf '%s\n' "sha=$expected"
  printf '%s\n' "run_id=$run_id"
}

case "${1:-}" in
  preflight)
    [ "$#" -eq 1 ] || fail 'usage: go-irl-stage-publish preflight'
    preflight
    ;;
  repair-layout)
    [ "$#" -eq 1 ] || fail 'usage: go-irl-stage-publish repair-layout'
    repair_layout
    ;;
  publish)
    [ "$#" -eq 3 ] || fail 'usage: go-irl-stage-publish publish <40-char-sha> <numeric-run-id>'
    publish "$2" "$3"
    ;;
  rollback)
    [ "$#" -eq 3 ] || fail 'usage: go-irl-stage-publish rollback <40-char-sha> <numeric-run-id>'
    rollback "$2" "$3"
    ;;
  *)
    fail 'allowed actions: preflight | repair-layout | publish <sha> <run-id> | rollback <sha> <run-id>'
    ;;
esac
